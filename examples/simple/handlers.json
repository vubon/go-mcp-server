{
  "version": "1.0.0",
  "serviceConfig": {
    "greeting-service": {
      "baseURL": "https://api.example.com",
      "timeout": "30s",
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "X-API-Key": "${API_KEY}"
      },
      "authorization": {
        "strategy": "pass-through",
        "headerName": "X-API-Key"
      },
      "retry": {
        "maxAttempts": 3,
        "initialDelay": "100ms",
        "maxDelay": "5s",
        "multiplier": 2.0,
        "jitter": true,
        "retryableStatusCodes": [500, 502, 503, 504],
        "retryableErrors": ["timeout", "connection_refused", "temporary"]
      },
      "circuitBreaker": {
        "maxFailures": 5,
        "timeout": "60s",
        "halfOpenMaxCalls": 3,
        "successThreshold": 2
      }
    }
  },
  "handlers": {
    "greet": {
      "type": "http",
      "method": "POST",
      "path": "/api/v1/greet",
      "headers": {
        "X-Request-ID": "${REQUEST_ID}",
        "X-Client-Version": "1.0.0"
      },
      "timeout": "5s"
    },
    "hello": {
      "type": "http",
      "method": "POST",
      "path": "/api/v1/hello",
      "headers": {
        "X-Feature-Flag": "new-hello-endpoint",
        "X-Request-ID": "${REQUEST_ID}"
      },
      "timeout": "15s"
    },
    "getUsers": {
      "type": "http",
      "method": "GET",
      "path": "/api/v1/users",
      "queryParams": {
        "page": "{page}",
        "limit": "{limit}",
        "sort": "{sort}",
        "format": "json"
      },
      "headers": {
        "X-Request-ID": "${REQUEST_ID}"
      },
      "timeout": "10s"
    }
  }
}

